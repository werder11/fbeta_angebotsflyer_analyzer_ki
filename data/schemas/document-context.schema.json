{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "description": "Normalized to 0..1, origin top-left.",
      "properties": {
        "x0": {
          "maximum": 1,
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "page_count": {
          "title": "Page Count",
          "type": "integer"
        },
        "campaign_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Year"
        },
        "campaign_year_source": {
          "anyOf": [
            {
              "enum": [
                "cli",
                "pdf_metadata"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Year Source"
        }
      },
      "required": [
        "id",
        "sha256",
        "filename",
        "page_count"
      ],
      "title": "Document",
      "type": "object"
    },
    "Offer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "page": {
          "default": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "product_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Name"
        },
        "brand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "description_lines": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Description Lines",
          "type": "array"
        },
        "badges": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Badges",
          "type": "array"
        },
        "image_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Description"
        },
        "price_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Raw"
        },
        "original_price_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Price Raw"
        },
        "discount_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discount Raw"
        },
        "quantity_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity Raw"
        },
        "unit_price_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price Raw"
        },
        "deposit_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deposit Raw"
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "original_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Price"
        },
        "discount_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discount Pct"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnitPrice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deposit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deposit"
        },
        "extraction_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Confidence"
        }
      },
      "required": [
        "id"
      ],
      "title": "Offer",
      "type": "object"
    },
    "PageImage": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "width_px": {
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "title": "Height Px",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "number",
        "width_px",
        "height_px",
        "path"
      ],
      "title": "PageImage",
      "type": "object"
    },
    "PageRef": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "target_page": {
          "title": "Target Page",
          "type": "integer"
        },
        "page": {
          "default": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "raw",
        "target_page"
      ],
      "title": "PageRef",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "pack_count": {
          "default": 1,
          "title": "Pack Count",
          "type": "integer"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "TextBlock": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "page": {
          "default": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "text"
      ],
      "title": "TextBlock",
      "type": "object"
    },
    "Unit": {
      "enum": [
        "g",
        "kg",
        "ml",
        "l",
        "piece",
        "sheet"
      ],
      "title": "Unit",
      "type": "string"
    },
    "UnitPrice": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "per_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "1",
          "title": "Per Amount"
        },
        "per_unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "value",
        "per_unit"
      ],
      "title": "UnitPrice",
      "type": "object"
    },
    "Validity": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "from_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Day"
        },
        "from_month": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Month"
        },
        "from_weekday": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Weekday"
        },
        "until_day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until Day"
        },
        "until_month": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until Month"
        },
        "until_weekday": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until Weekday"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "raw"
      ],
      "title": "Validity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document": {
      "$ref": "#/$defs/Document"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageImage"
      },
      "title": "Pages",
      "type": "array"
    },
    "offers": {
      "items": {
        "$ref": "#/$defs/Offer"
      },
      "title": "Offers",
      "type": "array"
    },
    "validity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Validity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "page_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PageRef"
      },
      "title": "Page Refs",
      "type": "array"
    },
    "text_blocks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TextBlock"
      },
      "title": "Text Blocks",
      "type": "array"
    }
  },
  "required": [
    "document",
    "pages",
    "offers"
  ],
  "title": "DocumentContext",
  "type": "object"
}
