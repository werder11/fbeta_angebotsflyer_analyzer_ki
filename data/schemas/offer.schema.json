{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "description": "Normalized to 0..1, origin top-left.",
      "properties": {
        "x0": {
          "maximum": 1,
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "pack_count": {
          "default": 1,
          "title": "Pack Count",
          "type": "integer"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Unit": {
      "enum": [
        "g",
        "kg",
        "ml",
        "l",
        "piece",
        "sheet"
      ],
      "title": "Unit",
      "type": "string"
    },
    "UnitPrice": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "per_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "1",
          "title": "Per Amount"
        },
        "per_unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "value",
        "per_unit"
      ],
      "title": "UnitPrice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "page": {
      "default": 1,
      "title": "Page",
      "type": "integer"
    },
    "bbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/BBox"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "image_bbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/BBox"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "product_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Name"
    },
    "brand": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brand"
    },
    "description_lines": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Description Lines",
      "type": "array"
    },
    "badges": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Badges",
      "type": "array"
    },
    "image_description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Description"
    },
    "price_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price Raw"
    },
    "original_price_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Price Raw"
    },
    "discount_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discount Raw"
    },
    "quantity_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantity Raw"
    },
    "unit_price_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Price Raw"
    },
    "deposit_raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deposit Raw"
    },
    "price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price"
    },
    "original_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Price"
    },
    "discount_pct": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discount Pct"
    },
    "quantity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unit_price": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnitPrice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deposit": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deposit"
    },
    "extraction_confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction Confidence"
    }
  },
  "required": [
    "id"
  ],
  "title": "Offer",
  "type": "object"
}
