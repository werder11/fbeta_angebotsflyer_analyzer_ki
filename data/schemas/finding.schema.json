{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "description": "Normalized to 0..1, origin top-left.",
      "properties": {
        "x0": {
          "maximum": 1,
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Category": {
      "enum": [
        "E01_product_image",
        "E02_master_data",
        "E03_arithmetic",
        "E04_quantity",
        "E05_association",
        "E06_temporal",
        "E07_semantic",
        "E08_completeness",
        "E09_cross_reference",
        "E10_visual_quality"
      ],
      "title": "Category",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "default": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "source": {
          "default": "flyer",
          "enum": [
            "flyer",
            "rule",
            "model",
            "reference"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Status": {
      "enum": [
        "pass",
        "fail",
        "needs_review",
        "not_evaluable",
        "error"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "check_id": {
      "title": "Check Id",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "offer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Offer Id"
    },
    "offer_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Offer Name"
    },
    "observed": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Observed",
      "type": "object"
    },
    "expected": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Expected",
      "type": "object"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "rule_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Version"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    }
  },
  "required": [
    "id",
    "check_id",
    "category",
    "severity",
    "status",
    "summary"
  ],
  "title": "Finding",
  "type": "object"
}
